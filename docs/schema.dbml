// À coller dans https://dbdiagram.io

Enum application_status {
  to_apply
  applied
  interview
  offer
  rejected
}

Table users {
  id integer [pk, increment]
  email varchar [unique, not null]
  password_hash varchar [not null]
  created_at timestamp [not null, default: `now()`]
}

Table companies {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.id]
  name varchar [not null]
  website varchar
  city varchar
  sector varchar
  created_at timestamp [not null, default: `now()`]
}

Table applications {
  id integer [pk, increment]
  company_id integer [not null, ref: > companies.id]
  position varchar [not null]
  status application_status [not null, default: 'to_apply']
  applied_at date
  follow_up_at date
  offer_url varchar
  notes text
  created_at timestamp [not null, default: `now()`]
}

Table contacts {
  id integer [pk, increment]
  company_id integer [not null, ref: > companies.id]
  name varchar [not null]
  role varchar
  email varchar
  phone varchar
  linkedin_url varchar
  created_at timestamp [not null, default: `now()`]
}
